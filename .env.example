PORT=3100
ARENA_MODE=fixture
ARENA_BIND_HOST=127.0.0.1
# Protocol mode only: protected external JSON configuration and optional studio key file.
ARENA_PROTOCOL_CONFIG=
ARENA_CACHE_DIR=.arena-cache
ARENA_STUDIO_KEY_FILE=
# Walletless free/free-live modes: loopback, no upstream credentials.
# For free-live, replace with an approved source config (docs/free-live.md).
ARENA_FREE_CONFIG=fixtures/free/viewer.json
# Everything below is for the explicit legacy mode.
ARENA_PUBLIC_URL=http://localhost:3100
BATTLEBOTS_URL=http://localhost:3000
DATABASE_URL=mysql://arena:arena_local@127.0.0.1:3307/arena
DATABASE_CA_PATH=
# Optional explicit server-only config file: ARENA_ENV_FILE=/path/to/local.env
ARENA_DEMO=true
ARENA_WORKER=true
ARENA_GAME_ID=
ARENA_PRIVATE_KEY=
ARENA_INTERNAL_KEY=
ARENA_MANIFEST_VERSION=1
ARENA_SLOT_SECONDS=300
ARENA_NOTICE_SECONDS=900
ARENA_PREMATCH_SECONDS=120
ARENA_WRAPUP_SECONDS=60
ARENA_REPLAY_DAYS=30
ARENA_PRACTICE_DAYS=7
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional comma-separated trusted reverse-proxy subnets
ARENA_TRUST_PROXY=
